NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_PROXY_ALLOWED_ORIGIN=http://localhost:3000
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000
SESSION_TOKEN_JWK={"kty":"oct","kid":"dev-session-1","alg":"HS256","k":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"}
REFRESH_TOKEN_JWK={"kty":"oct","kid":"dev-refresh-1","alg":"A256GCM","k":"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE"}
SESSION_REVOCATION_DATABASE=memory://

