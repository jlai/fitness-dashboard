NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Symmetric oct JWKs with a unique kid. The first key is used to mint new tokens; additional
# JWKS keys are kept for verification/decryption during rotation.
# Generate with:
# node -e "const {randomBytes}=require('crypto'); console.log(JSON.stringify({kty:'oct',kid:'session-1',alg:'HS256',k:randomBytes(32).toString('base64url')}))"
# node -e "const {randomBytes}=require('crypto'); console.log(JSON.stringify({kty:'oct',kid:'refresh-1',alg:'A256GCM',k:randomBytes(32).toString('base64url')}))"
# SESSION_TOKEN_JWK=
# REFRESH_TOKEN_JWK=

# Redirect URI registered on the Google OAuth client (must match GIS CodeClient)
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000

# Comma-separated list of origins allowed to call the Google OAuth token proxy
GOOGLE_OAUTH_PROXY_ALLOWED_ORIGIN=http://localhost:3000

# Session JWT lifetime in minutes (default 120)
# SITE_TOKEN_DEFAULT_EXPIRATION_MINUTES=120

# Session revocation store URL (default memory://)
# SESSION_REVOCATION_DATABASE=memory://
# SESSION_REVOCATION_DATABASE=cloudflare-kv://SESSION_REVOCATION

# Optional URL prefix when the app is not served at the domain root, e.g. /fitness
# NEXT_PUBLIC_BASE_PATH=
