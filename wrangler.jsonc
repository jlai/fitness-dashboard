{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Custom worker wraps OpenNext fetch and adds weekly key rotation.
  "main": "cloudflare-worker.ts",
  "name": "fitness-dashboard-beta",
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "fitness-dashboard-beta",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
  "keep_vars": true,
  "upload_source_maps": true,
  "secrets": {
    "required": ["GOOGLE_OAUTH_CLIENT_SECRET", "CLOUDFLARE_API_TOKEN"],
  },
  // Rotate session/health Secrets Store keys every Wednesday at 00:00 UTC.
  "triggers": {
    "crons": ["0 0 * * WED"],
  },
  // Create with `npx wrangler kv namespace create SESSION_REVOCATION` and replace the id.
  "kv_namespaces": [
    {
      "binding": "SESSION_REVOCATION",
      "id": "62e61823e79a41ee8221759d6689b387",
    },
  ],
  // Bind Cloudflare Secrets Store entries when TOKEN_SECRET_STORE=cloudflare-secrets://...
  "secrets_store_secrets": [
    { "binding": "SESSION_ACTIVE_KEY", "store_id": "<STORE_ID>", "secret_name": "SESSION_ACTIVE_KEY" },
    { "binding": "SESSION_ACCEPTED_KEYS", "store_id": "<STORE_ID>", "secret_name": "SESSION_ACCEPTED_KEYS" },
    { "binding": "HEALTH_ACTIVE_KEY", "store_id": "<STORE_ID>", "secret_name": "HEALTH_ACTIVE_KEY" },
    { "binding": "HEALTH_ACCEPTED_KEYS", "store_id": "<STORE_ID>", "secret_name": "HEALTH_ACCEPTED_KEYS" }
  ],
}
